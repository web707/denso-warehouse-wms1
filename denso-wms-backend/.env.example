# ===== Server =====
PORT=5001
NODE_ENV=development
# Comma-separated list of allowed frontend origins.
# Production example: CORS_ORIGIN=https://bingbing.com.vn,https://www.bingbing.com.vn,http://localhost:3000
CORS_ORIGIN=http://localhost:4310

# ===== Database (PostgreSQL) =====
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=bingbing
DB_PASSWORD=123456
DB_NAME=logidb

# ===== Auth (JWT) =====
JWT_ACCESS_SECRET=change-me-access-secret-please
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-please
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# ===== Seed =====
SEED_ADMIN_EMAIL=admin@denso-wms.local
SEED_ADMIN_PASSWORD=Admin@123456
SEED_WITH_SAMPLE_ORDER=true

# ===== Mail (optional; logs to console if empty) =====
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@denso-wms.local

# ===== App base URL (used to build reset-password links) =====
APP_PUBLIC_URL=http://localhost:4310
