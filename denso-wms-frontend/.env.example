# Vite loads .env.development in `vite`/dev mode and .env.production in
# `vite build` (default mode: production). Copy this file to one of those
# names locally if you need to override a value — both are gitignored.
#
# Local dev — relative path, rides the Vite proxy to localhost:5001, no CORS:
# VITE_API_BASE_URL=/api
#
# Production — absolute URL, frontend and backend are on different hosts:
# VITE_API_BASE_URL=https://api.example.com/api
VITE_API_BASE_URL=/api

# Public URL encoded into QR labels (LAN IP or deployed domain)
VITE_PUBLIC_APP_URL=
